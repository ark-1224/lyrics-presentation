# Copy to .env for local development. Never commit the real .env.

# Port the server listens on. Railway sets this automatically.
PORT=3000

# Where the database and uploaded videos are stored.
# Local default: ./data  |  On Railway: leave unset if a Volume is attached
# (the app then uses RAILWAY_VOLUME_MOUNT_PATH), or set it to your mount path, e.g. /data
# DATA_DIR=./data
